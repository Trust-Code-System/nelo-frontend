# Server-only. Never expose as NEXT_PUBLIC_*.
VENDURE_SHOP_API_URL=http://localhost:3000/shop-api

# Channel tokens. Routing identifiers, not secrets that grant privileged access — and never
# a substitute for session authentication. Obtain VERIFIED values from the backend team:
# the channel codes exist as constants but the Channels may not be provisioned yet.
VENDURE_CHANNEL_TOKEN_NG=
VENDURE_CHANNEL_TOKEN_INTERNATIONAL=

# Codegen source: a reachable /shop-api endpoint, or a path to an exported SDL.
VENDURE_SCHEMA=./schema/shop-api.graphql
