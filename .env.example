# Server-only. Never expose as NEXT_PUBLIC_*.
VENDURE_SHOP_API_URL=http://localhost:3000/shop-api

# Channel tokens. Routing identifiers, not secrets that grant privileged access — and never
# a substitute for session authentication. Obtain VERIFIED values from the backend team:
# the channel codes exist as constants but the Channels may not be provisioned yet.
VENDURE_CHANNEL_TOKEN_NG=
VENDURE_CHANNEL_TOKEN_INTERNATIONAL=

# Codegen source: a reachable /shop-api endpoint, or a path to an exported SDL.
VENDURE_SCHEMA=./schema/shop-api.graphql

# Absolute base for canonical tags, hreflang alternates and sitemap.xml. Server-only: the
# browser never needs it. Falls back to http://localhost:4310, deliberately — a canonical
# pointing at the wrong production host is worse than one pointing at an obvious local one.
NELO_SITE_URL=

# DEVELOPMENT ONLY. `enabled` wires checkout's final step to Vendure's dummy-payment-handler
# so the journey is end-to-end testable against ../vendure-dev. No money moves through it and
# it must never be set in a customer-facing deployment. Leave blank everywhere else.
NELO_DEV_PAYMENT=

# International (USD) checkout gate. Blank means closed: the catalogue, the bag and the
# atelier stay open but payment is withheld, because a USD catalogue does not prove the
# Paystack account can settle USD. Set to `enabled` only after the provider confirms it.
NELO_INTERNATIONAL_CHECKOUT=
